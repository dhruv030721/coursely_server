<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification - <%= companyName %></title>
    <style>
        /* Mobile-first responsive styles */
        @media only screen and (max-width: 600px) {
            .email-container {
                width: 100% !important;
                margin: 0 !important;
            }

            .content-wrapper {
                padding: 20px !important;
            }

            .header-content {
                padding: 30px 20px !important;
            }

            .header-title {
                font-size: 24px !important;
            }

            .section-title {
                font-size: 18px !important;
            }

            .otp-box {
                padding: 20px !important;
                font-size: 24px !important;
            }

            .otp-code {
                font-size: 32px !important;
                letter-spacing: 8px !important;
            }

            .cta-button {
                display: block !important;
                width: 100% !important;
                margin: 10px 0 !important;
                padding: 15px 20px !important;
                text-align: center !important;
                box-sizing: border-box !important;
            }

            .logo-img {
                max-width: 150px !important;
            }

            .footer-links {
                display: block !important;
                margin: 10px 0 !important;
            }

            .footer-links a {
                display: inline-block !important;
                margin: 5px 10px !important;
            }

            .timer-box {
                padding: 15px !important;
            }
        }
    </style>
</head>

<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f4f4;">
        <tr>
            <td align="center" style="padding: 20px 10px;">
                <table class="email-container" width="600" cellpadding="0" cellspacing="0"
                    style="background-color: #ffffff !important; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); max-width: 600px; width: 100%;">
                    <!-- Header -->
                    <tr>
                        <td class="header-content"
                            style="background: linear-gradient(135deg, #000000 0%, #09451e 50%, #4a2c2a 100%); padding: 40px 30px; text-align: center; border-radius: 10px 10px 0 0;">
                            <div style="margin-bottom: 20px;">
                                <img class="logo-img" src="<%= logoUrl %>" alt="<%= companyName %>"
                                    style="max-width: 180px; height: auto; display: block; margin: 0 auto;" />
                            </div>
                            <h1 class="header-title"
                                style="color: #ffffff !important; margin: 0; font-size: 28px; font-weight: bold; line-height: 1.2;">
                                Verify Your Account 🔐
                            </h1>
                        </td>
                    </tr>

                    <!-- Main Content -->
                    <tr>
                        <td class="content-wrapper" style="padding: 40px 30px;">
                            <div style="color: #333333; line-height: 1.6; text-align: center;">
                                <h2 style="color: #1a4d3a; margin-top: 0; font-size: 24px;">
                                    Hello <%= userName %>,
                                </h2>

                                <p style="font-size: 16px; margin-bottom: 30px;">
                                    To complete your account verification, please use the One-Time Password (OTP) below:
                                </p>

                                <!-- OTP Box -->
                                <div class="otp-box"
                                    style="background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%); padding: 30px; border-radius: 15px; margin: 30px 0; box-shadow: 0 4px 15px rgba(74, 222, 128, 0.3);">
                                    <div style="color: #ffffff; font-size: 14px; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;">
                                        Your OTP Code
                                    </div>
                                    <div class="otp-code"
                                        style="color: #ffffff; font-size: 36px; font-weight: bold; letter-spacing: 10px; font-family: 'Courier New', monospace; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">
                                        <%= otpCode %>
                                    </div>
                                </div>

                                <!-- Timer/Expiry Notice -->
                                <div class="timer-box"
                                    style="background-color: #fef3c7; padding: 20px; border-radius: 8px; border-left: 4px solid #f59e0b; margin: 25px 0;">
                                    <div style="color: #92400e; font-weight: bold; margin-bottom: 5px;">
                                        ⏰ Important Notice
                                    </div>
                                    <p style="color: #92400e; margin: 0; font-size: 14px;">
                                        This OTP will expire in <strong><%= expiryTime %> minutes</strong>. Please complete your verification before the time expires.
                                    </p>
                                </div>

                                <!-- Instructions -->
                                <div
                                    style="background-color: #f0f9ff; padding: 25px; border-radius: 8px; border-left: 4px solid #0ea5e9; margin: 25px 0; text-align: left;">
                                    <h3 class="section-title" style="color: #1a4d3a; margin-top: 0; font-size: 18px;">
                                        📋 How to Use Your OTP
                                    </h3>
                                    <ul style="color: #333333; padding-left: 20px; margin: 0;">
                                        <li style="margin-bottom: 8px;">Copy the OTP code above</li>
                                        <li style="margin-bottom: 8px;">Return to the verification page</li>
                                        <li style="margin-bottom: 8px;">Enter the OTP in the verification field</li>
                                        <li>Click "Verify" to complete the process</li>
                                    </ul>
                                </div>

                                <!-- Security Notice -->
                                <div
                                    style="background-color: #fef2f2; color: #991b1b; padding: 20px; border-radius: 8px; border-left: 4px solid #ef4444; margin: 25px 0; text-align: left;">
                                    <h3 style="margin-top: 0; color: #991b1b; font-size: 16px;">
                                        🛡️ Security Reminder
                                    </h3>
                                    <ul style="margin: 0; padding-left: 20px; font-size: 14px;">
                                        <li style="margin-bottom: 5px;">Never share your OTP with anyone</li>
                                        <li style="margin-bottom: 5px;">We will never ask for your OTP over phone or email</li>
                                        <li>If you didn't request this OTP, please ignore this email</li>
                                    </ul>
                                </div>

                                <p style="font-size: 14px; color: #666666; margin-top: 30px;">
                                    If you're having trouble with verification, please contact our support team at 
                                    <a href="mailto:<%= supportEmail %>" style="color: #4ade80; text-decoration: none;"><%= supportEmail %></a>
                                </p>

                                <p style="font-size: 16px; margin-bottom: 30px; margin-top: 30px;">
                                    Thank you for choosing <%= companyName %>!<br>
                                    <strong>The <%= companyName %> Team</strong>
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            style="background-color: #f8f9fa; padding: 30px 20px; text-align: center; border-radius: 0 0 10px 10px;">
                            <div style="color: #666666; font-size: 14px; line-height: 1.5;">
                                <p style="margin: 0 0 15px 0;">
                                    Need help? Contact us:
                                </p>
                                <div class="footer-links" style="margin: 15px 0;">
                                    <a href="<%= websiteUrl %>"
                                        style="color: #4ade80; text-decoration: none; margin: 0 10px;">Website</a> 
                                </div>
                                <p style="margin: 15px 0 0 0; font-size: 12px; color: #999999;">
                                    This is an automated security email from <%= companyName %>.
                                    <a href="<%= privacyUrl %>" style="color: #4ade80; text-decoration: none;">Privacy Policy</a>
                                </p>
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>